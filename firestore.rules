rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function membershipPath(userId, groupId) {
      return /databases/$(database)/documents/users/$(userId)/groups/$(groupId);
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function isMember(groupId) {
      return signedIn() && exists(membershipPath(request.auth.uid, groupId));
    }

    function isMemberAfter(groupId) {
      return signedIn()
        && existsAfter(membershipPath(request.auth.uid, groupId));
    }

    function isGroupOwner(groupId) {
      return signedIn()
        && exists(
          groupPath(groupId)
        )
        && get(groupPath(groupId)).data.createdBy == request.auth.uid;
    }

    function isGroupActive(groupId) {
      return exists(groupPath(groupId))
        && get(groupPath(groupId)).data.deleting != true;
    }

    function isGroupActiveAfter(groupId) {
      return existsAfter(groupPath(groupId))
        && getAfter(groupPath(groupId)).data.deleting != true;
    }

    match /groupInvites/{inviteCode} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.groupId is string
        && getAfter(
          /databases/$(database)/documents/groups/$(request.resource.data.groupId)
        ).data.createdBy == request.auth.uid
        && isGroupActiveAfter(request.resource.data.groupId);
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.createdBy == request.auth.uid;
    }

    match /users/{userId}/groups/{groupId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'name',
          'currencyCode',
          'inviteCode',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.currencyCode is string
        && request.resource.data.inviteCode is string
        && isGroupActiveAfter(groupId)
        && (
          (
            existsAfter(
              /databases/$(database)/documents/groups/$(groupId)
            )
            && getAfter(
              /databases/$(database)/documents/groups/$(groupId)
            ).data.createdBy == userId
          )
          || (
            exists(
              /databases/$(database)/documents/groupInvites/$(request.resource.data.inviteCode)
            )
            && get(
              /databases/$(database)/documents/groupInvites/$(request.resource.data.inviteCode)
            ).data.groupId == groupId
          )
        );
      allow update: if false;
      allow delete: if isGroupOwner(groupId);
    }

    match /groups/{groupId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'name',
          'currencyCode',
          'createdBy',
          'createdAt'
        ])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.currencyCode is string;
      allow get: if isMember(groupId);
      allow list: if false;
      allow update: if signedIn()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['deleting'])
        && request.resource.data.deleting == true;
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      match /members/{memberId} {
        allow read: if isMember(groupId);
        allow create: if signedIn()
          && request.auth.uid == memberId
          && isMemberAfter(groupId)
          && isGroupActiveAfter(groupId)
          && request.resource.data.keys().hasOnly([
            'name',
            'contribution',
            'joinedAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.contribution is number
          && request.resource.data.contribution >= 0;
        allow update: if signedIn()
          && request.auth.uid == memberId
          && isMember(groupId)
          && isGroupActive(groupId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['contribution'])
          && request.resource.data.contribution is number
          && request.resource.data.contribution > resource.data.contribution;
        allow delete: if isGroupOwner(groupId);
      }

      match /expenses/{expenseId} {
        allow read: if isMember(groupId);
        allow create: if isMember(groupId)
          && isGroupActive(groupId)
          && request.resource.data.keys().hasOnly([
            'title',
            'category',
            'amount',
            'paidBy',
            'paidByName',
            'createdAt'
          ])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.category is string
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.paidBy == request.auth.uid
          && request.resource.data.paidByName is string;
        allow update: if false;
        allow delete: if isGroupOwner(groupId);
      }
    }
  }
}
